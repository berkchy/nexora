+// 64-bit-cell builds reinterpret a cell as a *double* bit-pattern (amx_ctof).
+// Classic plugins pass plain int arrays to vector/float pev fields (eg
+// set_pev(ent, pev_punchangle, {255,255,255}) for Zombie Plague colors) which
+// reinterpret to subnormal doubles and underflow to zero once narrowed to a
+// single float. Cells whose double exponent is zero (0.0, subnormals, or any
+// integer < 2^52) are treated as integers and converted numerically - matching
+// the numeric conversions used elsewhere in this port (eg fun:set_user_health).
+static float fm_ctof(cell c)
+{
+#if PAWN_CELL_SIZE == 64
+	if ((static_cast<uint64_t>(c) >> 52 & 0x7FF) == 0)
+	{
+		return static_cast<float>(static_cast<int64_t>(c));
+	}
+#endif
+	return (float)amx_ctof(c);
+}
