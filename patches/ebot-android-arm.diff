@@ -1417,6 +1417,42 @@
 
 void Bot::MoveAction(void)
 {
+	// Diagnostic think log (file only, never console): what each bot wants,
+	// throttled to one line per bot every 2 seconds, 2MB rotation.
+	if (engine->GetTime() >= m_thinkLogTimer)
+	{
+		m_thinkLogTimer = engine->GetTime() + 2.0f;
+
+		char logPath[1024];
+		FormatBuffer(logPath, "%s/addons/ebot/logs/think.log", GetModName());
+
+		FILE* probe = fopen(logPath, "rb");
+		if (probe)
+		{
+			fseek(probe, 0L, SEEK_END);
+			const bool tooBig = ftell(probe) > 2 * 1024 * 1024;
+			fclose(probe);
+			if (tooBig)
+				remove(logPath);
+		}
+
+		FILE* log = fopen(logPath, "at");
+		if (log)
+		{
+			const char* enemyName = (m_hasEnemiesNear && !FNullEnt(m_nearestEnemy)) ? GetEntityName(m_nearestEnemy) : "none";
+			fprintf(log, "[%.1f] %s wp=%d nav=[%d..%d]x%d dest=(%.0f,%.0f,%.0f) enemy=%s edist=%.0f wpn=%d proc=%d spd=%.0f\n",
+				engine->GetTime(), GetEntityName(GetEntity()),
+				static_cast<int>(m_currentWaypointIndex),
+				m_navNode.IsEmpty() ? -1 : static_cast<int>(m_navNode.First()),
+				m_navNode.IsEmpty() ? -1 : static_cast<int>(m_navNode.Last()),
+				static_cast<int>(m_navNode.Length()),
+				m_destOrigin.x, m_destOrigin.y, m_destOrigin.z,
+				enemyName ? enemyName : "none", m_enemyDistance, m_currentWeapon,
+				static_cast<int>(m_currentProcess), m_moveSpeed);
+			fclose(log);
+		}
+	}
+
 	if (m_buttons & IN_JUMP)
 		m_jumpTime = engine->GetTime();
 
