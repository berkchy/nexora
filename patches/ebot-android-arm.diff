diff -Naur '--exclude=.git' /storage/emulated/0/Documents/project/cs16client/3rdparty/ebot/source/support.cpp ebotw2/source/support.cpp
--- a/source/support.cpp	2026-09-23 11:11:33.871996582 +0300
+++ b/source/support.cpp	2026-09-24 12:39:50.329458188 +0300
@@ -637,7 +637,26 @@
 
 bool IsZombieEntity(edict_t* ent)
 {
-	return GetTeam(ent) == Team::Terrorist;
+	if (GetTeam(ent) == Team::Terrorist)
+		return true;
+
+	// Zombie Plague keeps the human team on infected players, so team alone
+	// can't spot them: fall back to the player model name (ZP zombie models
+	// carry "zombie" in the path). Human models never match.
+	if (FNullEnt(ent))
+		return false;
+
+	const char* model = STRING(ent->v.model);
+	if (IsNullString(model))
+		return false;
+
+	char lowered[128];
+	size_t i = 0;
+	for (; i < sizeof(lowered) - 1 && model[i] != '\0'; ++i)
+		lowered[i] = static_cast<char>(ctolower(static_cast<unsigned char>(model[i])));
+	lowered[i] = '\0';
+
+	return cstrstr(lowered, "zombie") != nullptr;
 }
 
