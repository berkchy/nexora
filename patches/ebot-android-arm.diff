@@ -26,7 +26,11 @@
 #define MULTIPLE_INHERITANCE
 #endif
 
-// Maximum and minimum representable values
+// Maximum and minimum representable values (MSVC compat: system headers
+// already provide correct values on Linux/Android, and ebot's LONG-based
+// ones are even wrong on LP64 — plus UINT64_MAX here uses undeclared
+// uint64 and poisons libc++ headers that use the system macro).
+#ifdef _WIN32
 #define	INT8_MAX	SCHAR_MAX
 #define	INT16_MAX	 SHRT_MAX
 #define	INT32_MAX	 LONG_MAX
@@ -46,6 +50,7 @@
 #define	UINT16_MIN	0
 #define	UINT32_MIN	0
 #define	UINT64_MIN	0
+#endif // _WIN32 shims above; non-Windows uses system <stdint.h>/<limits.h>
 
 #ifndef	UINT_MIN
 #define	UINT_MIN	UINT32_MIN
diff -Naur '--exclude=.git' csebot/include/runtime.h ebotw/include/runtime.h
--- a/include/runtime.h	2026-09-23 10:34:33.935998170 +0300
+++ b/include/runtime.h	2026-09-23 11:18:02.879996304 +0300
@@ -662,6 +662,7 @@
 	}
 };
 
+#if defined(__SSE__) || (defined(_M_IX86_FP) && _M_IX86_FP >= 1) || defined(__x86_64__) || defined(_M_X64)
 #include <xmmintrin.h>
 inline float GetVectorDistanceSSE(const Vector vec1, const Vector vec2)
 {
@@ -671,6 +672,17 @@
 	sum = _mm_add_ss(sum, _mm_shuffle_ps(sum, sum, 0x55));
 	return _mm_cvtss_f32(_mm_sqrt_ss(sum));
 }
+#else
+// No SSE (e.g. ARM): scalar fallback, same result.
+#include <math.h>
+inline float GetVectorDistanceSSE(const Vector vec1, const Vector vec2)
+{
+	const float dx = vec1.x - vec2.x;
+	const float dy = vec1.y - vec2.y;
+	const float dz = vec1.z - vec2.z;
+	return sqrtf(dx * dx + dy * dy + dz * dz);
+}
+#endif
 
 namespace Math
